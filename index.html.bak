	<!-- Timeline Expand/Collapse CSS -->
	<style>
		.timeline-header {
			cursor: pointer;
			display: flex;
			justify-content: space-between;
			align-items: flex-start;
			padding: 10px 0;
			transition: all 0.3s ease;
		}

		.timeline-header:hover {
			opacity: 0.8;
		}

		.timeline-title {
			flex: 1;
		}

		.timeline-arrow {
			margin-left: 15px;
			font-size: 14px;
			color: #2ca46d;
			transition: transform 0.3s ease;
			margin-top: 5px;
		}

		.timeline-header.active .timeline-arrow {
			transform: rotate(180deg);
		}

		.timeline-content {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.4s ease-out;
		}

		.timeline-content.expanded {
			max-height: 1000px;
			transition: max-height 0.5s ease-in;
		}

		.timeline-details {
			margin-top: 15px;
			padding-top: 15px;
			border-top: 1px solid #e0e0e0;
			opacity: 0;
			transition: opacity 0.3s ease 0.2s;
		}

		.timeline-content.expanded .timeline-details {
			opacity: 1;
		}

		.timeline-details p {
			margin-bottom: 10px;
			color: #666;
			line-height: 1.6;
		}

		.timeline-details p:last-child {
			margin-bottom: 0;
		}

		/* Footer Enhanced Styles */
		.footer_widget {
			margin-bottom: 30px;
		}

		.footer_widget h4 {
			color: #1d293e;
			font-size: 18px;
			font-weight: 600;
			margin-bottom: 20px;
			position: relative;
			padding-bottom: 10px;
		}

		.footer_widget h4:after {
			content: '';
			position: absolute;
			left: 0;
			bottom: 0;
			width: 40px;
			height: 2px;
			background: #2ca46d;
		}

		.footer_widget p {
			color: #1d293e;
			line-height: 1.8;
			margin-bottom: 20px;
		}

		.footer_menu {
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.footer_menu li {
			margin-bottom: 10px;
		}

		.footer_menu li a {
			color: #1d293e;
			text-decoration: none;
			transition: all 0.3s ease;
			display: inline-block;
		}

		.footer_menu li a:hover {
			color: #2ca46d;
			padding-left: 5px;
		}

		.footer_contact {
			list-style: none;
			padding: 0;
			margin: 0;
		}

		.footer_contact li {
			margin-bottom: 15px;
			color: #1d293e;
			display: flex;
			align-items: flex-start;
		}

		.footer_contact li i {
			color: #2ca46d;
			margin-right: 10px;
			margin-top: 5px;
			width: 20px;
		}

		.footer_contact li a {
			color: #1d293e;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.footer_contact li a:hover {
			color: #2ca46d;
		}

		.footer_social ul {
			list-style: none;
			padding: 0;
			margin: 20px 0 0 0;
			display: flex;
			gap: 10px;
		}

		.footer_social ul li a {
			width: 40px;
			height: 40px;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			background: rgba(255, 255, 255, 0.1);
			border-radius: 50%;
			color: #fff;
			transition: all 0.3s ease;
		}

		.footer_social ul li a:hover {
			background: #2ca46d;
			transform: translateY(-3px);
		}

		.footer_bottom {
			margin-top: 40px;
			padding-top: 30px;
			border-top: 1px solid rgba(255, 255, 255, 0.1);
		}

		.footer_bottom p {
			color: #1d293e;
			margin: 0;
			font-size: 14px;
		}

		@media (max-width: 768px) {
			.footer_bottom .text-right {
				text-align: left !important;
				margin-top: 10px;
			}
		}

		/* Site Logo - Kế thừa style từ trang chủ */
		.site-logo a {
			font-family: 'Quicksand', sans-serif;
			color: #1d293e;
			font-weight: 700;
			font-size: 28px;
			text-decoration: none;
			transition: all 0.3s ease;
			display: inline-block;
		}

		.site-logo a:hover {
			color: #2ca46d;
			text-decoration: none;
		}

		@media (max-width: 768px) {
			.site-logo a {
				font-size: 24px;
			}
		}

		@media (max-width: 480px) {
			.site-logo a {
				font-size: 20px;
			}
		}

		/* Mobile - Đổi màu text sang trắng cho phần hero */
		@media (max-width: 768px) {
			.welcome-area .about_me_title h1 {
				color: #fff !important;
				text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
			}

			.welcome-area .about_me_title h4 {
				color: #fff !important;
				text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
			}

			.welcome-area .profile_info {
				color: #fff !important;
			}

			.welcome-area .profile_info span {
				color: #fff !important;
				text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
			}

			.welcome-area .profile_info span i {
				color: #fff !important;
			}
		}
	</style>

</head>

