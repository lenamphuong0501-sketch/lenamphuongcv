	<!-- Timeline Expand/Collapse JS -->
	<script>
		function toggleTimeline(header) {
			var timeline = header.closest('.single_timeline');
			var content = timeline.querySelector('.timeline-content');
			var isExpanded = content.classList.contains('expanded');

			// Toggle active class on header
			header.classList.toggle('active');

			// Toggle expanded class on content
			if (isExpanded) {
				content.classList.remove('expanded');
			} else {
				content.classList.add('expanded');
			}
		}
	</script>
	<!-- Auto-play Service Slider -->
	<script>
		$(document).ready(function() {
			// Đợi một chút để đảm bảo scripts-dark.js đã load xong
			setTimeout(function() {
				// Destroy carousel cũ nếu đã được khởi tạo
				var $slider = $("#sp-slider");
				if ($slider.data('owlCarousel')) {
					$slider.data('owlCarousel').destroy();
				}
				
				// Khởi tạo lại với autoplay
				$slider.owlCarousel({
					items: 3,
					itemsDesktop: [1199, 3],
					itemsDesktopSmall: [979, 2],
					itemsTablet: [768, 2],
					itemsMobile: [600, 1],
					pagination: false,
					navigation: true,
					navigationText: ["", ""],
					slideSpeed: 1000,
					autoPlay: 2000,  // Tự động cuộn sau mỗi 2 giây (2000ms)
					stopOnHover: true  // Dừng khi hover chuột vào
				});
			}, 100);
		});
	</script>
	
